.ruler-page {
  min-height: 100vh;
  padding: 20rpx 18rpx 140rpx;
}

.ruler-toolbar {
  display: grid;
  grid-template-columns: 64rpx minmax(0, 1fr) 38rpx;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx;
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  background: #ffffff;
}

.period-label {
  color: var(--muted);
  font-size: 22rpx;
  text-align: center;
}

.period-tabs {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.period-tabs view {
  position: relative;
  min-width: 0;
  height: 58rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 58rpx;
  text-align: center;
}

.period-tabs view.active {
  color: var(--ink);
  font-weight: 650;
}

.period-tabs view.active::after {
  position: absolute;
  right: 25%;
  bottom: 0;
  left: 25%;
  height: 4rpx;
  border-radius: 2rpx;
  background: #1769aa;
  content: "";
}

.line-status {
  display: flex;
  min-height: 96rpx;
  align-items: center;
  justify-content: space-between;
  padding: 0 12rpx;
}

.status-title,
.status-meta {
  display: block;
}

.status-title {
  font-size: 25rpx;
  font-weight: 650;
}

.status-meta {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 20rpx;
}

.color-indicator {
  width: 26rpx;
  height: 26rpx;
  border: 5rpx solid #ffffff;
  border-radius: 50%;
  box-shadow: 0 0 0 1rpx #cfd6df;
}

.draw-matrix {
  overflow: hidden;
  border: 1rpx solid #dce3ea;
  border-radius: 8rpx;
  background: #ffffff;
}

.matrix-grid {
  display: grid;
  grid-template-columns: 116rpx 56rpx repeat(5, minmax(0, 1fr)) 8rpx repeat(2, minmax(0, 1fr));
}

.matrix-header {
  min-height: 70rpx;
  align-items: center;
  border-bottom: 1rpx solid #dce3ea;
  background: #f6f8fa;
  color: var(--muted);
  font-size: 20rpx;
  text-align: center;
}

.matrix-header .front-head {
  grid-column: 3 / 8;
}

.matrix-header .divider-head {
  grid-column: 8;
}

.matrix-header .back-head {
  grid-column: 9 / 11;
}

.matrix-body {
  position: relative;
}

.rule-canvas {
  position: absolute;
  z-index: 3;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.matrix-row {
  position: relative;
  z-index: 2;
  min-height: 98rpx;
  align-items: stretch;
  border-bottom: 1rpx solid #e5e9ef;
}

.matrix-row:last-child {
  border-bottom: 0;
}

.issue-cell,
.sum-cell,
.number-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  border-right: 1rpx solid #e5e9ef;
}

.issue-cell {
  flex-direction: column;
  background: #eef7f2;
  font-size: 22rpx;
  font-weight: 650;
}

.issue-cell text + text {
  margin-top: 5rpx;
  color: var(--muted);
  font-size: 18rpx;
  font-weight: 400;
}

.sum-cell {
  background: #fffceb;
  color: #5f6570;
  font-size: 22rpx;
  font-weight: 600;
}

.number-cell {
  position: relative;
  min-width: 0;
  border: 3rpx solid transparent;
  background: #ffffff;
}

.number-cell text {
  display: flex;
  width: 50rpx;
  height: 50rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 22rpx;
  font-weight: 650;
}

.number-cell.front text {
  color: #c13f36;
  background: #fff0ef;
}

.number-cell.back {
  background: #f3f8fc;
}

.number-cell.back text {
  color: #1769aa;
  background: #e8f2fa;
}

.number-cell.selected {
  z-index: 5;
}

.number-cell.selected text {
  color: #ffffff;
}

.pool-divider {
  border-right: 1rpx solid #cbd4df;
  border-left: 1rpx solid #cbd4df;
  background: #eef1f5;
}

.ruler-actions {
  position: fixed;
  z-index: 20;
  right: 18rpx;
  bottom: 18rpx;
  left: 18rpx;
  display: grid;
  grid-template-columns: 1fr 1.25fr 1fr;
  gap: 10rpx;
  padding: 12rpx;
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -6rpx 24rpx rgba(25, 35, 51, 0.08);
}

.tool-button {
  min-width: 0;
  height: 70rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid #ccd5df;
  background: #ffffff;
  color: var(--ink);
  font-size: 23rpx;
  line-height: 68rpx;
}

.tool-button.finish {
  border-color: #1769aa;
  background: #1769aa;
  color: #ffffff;
}

.tool-button.danger {
  color: #b83d36;
}

.tool-button[disabled] {
  border-color: #e1e6ec;
  background: #f1f3f6;
  color: #a3acb8;
}

.matrix-skeleton {
  height: 900rpx;
  border-radius: 8rpx;
  background: #e9edf2;
}
